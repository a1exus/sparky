# Image tags. Defaults below track `latest` for convenience.
# In production, pin to specific releases in your local .env:
#   OLLAMA_TAG=0.23.4
#   OPEN_WEBUI_TAG=v0.9.5
# Releases: https://github.com/ollama/ollama/releases
#           https://github.com/open-webui/open-webui/releases
OLLAMA_TAG=latest
OPEN_WEBUI_TAG=latest

# Open WebUI session secret. Generate with: openssl rand -hex 32
# REQUIRED — compose refuses to start if unset.
WEBUI_SECRET_KEY=

# Require login (true) or run open (false). Keep true.
WEBUI_AUTH=true

# Allow new user signups. Leave true for initial admin registration,
# then set to false and `docker compose up -d` to lock down.
ENABLE_SIGNUP=true

# Keep models loaded in memory after inactivity. 30m keeps agent clients' prompt
# cache warm across pauses between turns. Examples: "30m" (default), "5m", "-1" (forever), "0" (unload immediately).
OLLAMA_KEEP_ALIVE=30m

# DGX Spark (GB10) memory tuning — see docker-compose.yml for rationale.
# Flash attention must stay on for a quantized KV cache.
OLLAMA_FLASH_ATTENTION=1
# KV cache quantization: f16 (full precision), q8_0 (half the memory), q4_0 (quarter; some quality loss).
# f16 by default — Qwen-family models lose the most from quantization; switch only if memory is tight.
OLLAMA_KV_CACHE_TYPE=f16
# Default context window. Unset, Ollama picks 256k on the Spark. OpenAI-compatible
# clients (/v1/chat/completions) can't override it, so keep it above their largest prompt.
OLLAMA_CONTEXT_LENGTH=131072

# Local-only mode: disables Ollama cloud models and web search. Set 0 to re-enable.
OLLAMA_NO_CLOUD=1

# Memory (bytes) Ollama leaves free for the OS and other GPU stacks. Default 8 GiB.
OLLAMA_GPU_OVERHEAD=8589934592
