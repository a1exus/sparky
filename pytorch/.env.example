# PyTorch dev container config. Copy this to .env once (`make up` does it
# automatically on first run).

# NGC PyTorch image tag — required, no default. Pick the newest tag that
# passes `make check` on this host (GB10 = aarch64, compute capability 12.1).
# Tags: https://catalog.ngc.nvidia.com/orgs/nvidia/containers/pytorch/tags
# Example format: 25.09-py3
PYTORCH_TAG=

# Host user the container runs as. `make` fills these from `id -u` / `id -g`;
# set them here only when running raw `docker compose`.
# PYTORCH_UID=1000
# PYTORCH_GID=1000

# Host paths bind-mounted into the container.
# WORKSPACE=./workspace
# CACHE_HOST=./cache
# Holds HuggingFace downloads; shared with vllm / llama-cpp.
HF_CACHE_HOST=/opt/hf/.cache/huggingface

# Shared memory for dataloader workers (ipc: host already covers most cases).
# SHM_SIZE=16gb

# Optional HuggingFace token (gated/private models).
HF_TOKEN=
